---
import {
  getRelativeLocaleUrl,
  getAbsoluteLocaleUrl,
  getAbsoluteLocaleUrlList,
} from 'astro:i18n';

const results = {
  "getRelativeLocaleUrl('pl')": getRelativeLocaleUrl('pl'),
  "getRelativeLocaleUrl('pl', '')": getRelativeLocaleUrl('pl', ''),
  "getRelativeLocaleUrl('pl', '/')": getRelativeLocaleUrl('pl', '/'),
  "getRelativeLocaleUrl('pl', 'docs/setup')": getRelativeLocaleUrl('pl', 'docs/setup'),
  "getRelativeLocaleUrl('pl', 'docs/setup/', { prependWith: 'blog' })": getRelativeLocaleUrl('pl', 'docs/setup/', { prependWith: 'blog' }),
  "getAbsoluteLocaleUrl('pl', '')": getAbsoluteLocaleUrl('pl', ''),
  "getAbsoluteLocaleUrlList('')": getAbsoluteLocaleUrlList(''),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>astro:i18n trailingSlash: 'never' repro</title>
  </head>
  <body>
    <h1>config: <code>trailingSlash: 'never'</code>, locales en (default) + pl</h1>
    <ul>
      {Object.entries(results).map(([call, url]) => (
        <li><code>{call}</code> → <code>{JSON.stringify(url)}</code></li>
      ))}
    </ul>
    <p>Real-world case — language switcher link to the Polish home page:</p>
    <a href={getRelativeLocaleUrl('pl', '')}>Polski</a>
    <script type="application/json" id="results" set:html={JSON.stringify(results)} />
  </body>
</html>
